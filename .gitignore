# ============================================================
# AgriAgent Expo App — .gitignore
# ============================================================
# --- Dependencies ---
node_modules/
.pnp
.pnp.js
# --- Expo ---
.expo/
.expo-shared/
dist/
web-build/
.metro-health-check*
# --- Build artifacts ---
build/
*.apk
*.aab
*.ipa
*.hbc
*.zip
*.tar.gz
*.tgz
apk-contents/
app-inspect.zip
# --- Android / iOS native (regenerated by EAS) ---
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
credentials.json
credentials/
google-services.json
GoogleService-Info.plist
serviceAccountKey.json
firebase-adminsdk*.json
# --- Env & secrets ---
.env
.env.local
.env.*.local
!.env.example
# --- Backups & junk ---
*.bak
*.bak_*
*.bak2_*
*.old_*
.git_broken_*/
.gitignore.old_*
*.exe
$*
git-installer.exe
# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
# --- Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.orig.*
# --- Test coverage ---
coverage/
