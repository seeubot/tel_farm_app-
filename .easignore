# -------------------------
# Node modules (biggest culprit)
# -------------------------
node_modules/
**/node_modules/

# -------------------------
# Android build artifacts
# -------------------------
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/*.iml
android/local.properties
android/captures/

# -------------------------
# iOS build artifacts
# -------------------------
ios/build/
ios/Pods/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/

# -------------------------
# Expo / Metro cache
# -------------------------
.expo/
.expo-shared/
dist/
web-build/
.metro-health-check*

# -------------------------
# Git
# -------------------------
.git/
.gitignore

# -------------------------
# Logs & temp files
# -------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache/
.yarn/unplugged/
.pnp.*

# -------------------------
# Test & coverage
# -------------------------
coverage/
__tests__/
**/__tests__/
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
jest.config.*
jest.setup.*

# -------------------------
# Docs & assets not needed for build
# -------------------------
docs/
*.md
README*
CHANGELOG*
LICENSE*

# -------------------------
# Dev & editor config
# -------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# -------------------------
# CI/CD configs
# -------------------------
.github/
.circleci/
.travis.yml
Jenkinsfile
.gitlab-ci.yml

# -------------------------
# Environment files (keep .env used by EAS)
# -------------------------
.env.local
.env.development
.env.test
# DO NOT ignore .env or .env.production if EAS needs them

# -------------------------
# Misc
# -------------------------
*.zip
*.tar.gz
*.rar
*.7z
*.apk
*.aab
*.ipa
